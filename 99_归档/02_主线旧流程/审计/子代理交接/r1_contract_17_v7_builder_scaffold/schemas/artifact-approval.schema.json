{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:contract-v7:artifact-approval-v1",
  "title": "ARTIFACT-APPROVAL-V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_contract_version",
    "approval_id",
    "artifact_kind",
    "artifact_id",
    "artifact_canonical_sha256",
    "approved_by",
    "approved_date",
    "approval_status",
    "notes"
  ],
  "properties": {
    "approval_contract_version": {"const": "ARTIFACT-APPROVAL-V1"},
    "approval_id": {"type": "string", "minLength": 1},
    "artifact_kind": {"const": "source_pool_113_prerequisite"},
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "approval_status": {"const": "approved"},
    "notes": {"type": ["string", "null"]}
  }
}
